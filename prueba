<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>🎉 ¡Feliz Cumpleaños! 🎂</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      margin: 0;
      background: linear-gradient(135deg, #ffdde1, #ee9ca7);
      text-align: center;
      color: #333;
    }

    header {
      padding: 40px 20px;
      background-color: rgba(255, 255, 255, 0.6);
      border-bottom: 2px solid #fff;
    }

    h1 {
      font-size: 3em;
      margin: 0;
      color: #ff4081;
    }

    p {
      font-size: 1.2em;
    }

    .album {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      padding: 30px;
    }

    .foto {
      background: white;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      transition: transform 0.3s;
    }

    .foto img {
      width: 100%;
      height: auto;
      display: block;
    }

    .foto:hover {
      transform: scale(1.05);
    }

    footer {
      margin-top: 20px;
      padding: 15px;
      background: rgba(255,255,255,0.7);
      font-size: 0.9em;
    }
  </style>
</head>
<body>

  <header>
    <h1>🎉 ¡Feliz Cumpleaños, mami! 🎂</h1>
    <p>Hoy celebramos un día muy especial la mejor del planeta ✨💖</p>
  </header>

  <section class="album">
    <!-- Aquí pones tus fotos -->
    <div class="foto"><img src="imagenes/foto1.jpg" alt="Recuerdo 1"></div>
    <div class="foto"><img src="imagenes/foto2.jpg" alt="Recuerdo 2"></div>
    <div class="foto"><img src="imagenes/foto3.jpg" alt="Recuerdo 3"></div>
    <div class="foto"><img src="imagenes/foto4.jpg" alt="Recuerdo 4"></div>
    <div class="foto"><img src="imagenes/foto5.jpg" alt="Recuerdo 5"></div>
    <div class="foto"><img src="imagenes/foto6.jpg" alt="Recuerdo 6"></div>
    <div class="foto"><img src="imagenes/foto7.jpg" alt="Recuerdo 7"></div>
    <div class="foto"><img src="imagenes/foto8.jpg" alt="Recuerdo 8"></div>
    <div class="foto"><img src="imagenes/foto9.jpg" alt="Recuerdo 9"></div>
    <div class="foto"><img src="Imagen de WhatsApp 2025-08-21 a las 18.53.08_cf3cffa4.jpg" alt="Recuerdo 10"></div>
  </section>

  <footer>
    Con mucho cariño 💕 – De Tu Albert
  </footer>

  <!-- Música -->
  <audio id="bg-music" src="Kany-Garc-a-Garc-a-(CeeNaija.com).mp3" loop></audio>

  <script>
    window.addEventListener('click', () => {
      const music = document.getElementById('bg-music');
      music.play();
    });
  </script>

</body>
</html>
